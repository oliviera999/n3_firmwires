#pragma once

// Copier ce fichier en secrets.h (non versionné), puis renseigner les valeurs.

#define PGL_WIFI_SSID_1 "VOTRE_WIFI_1"
#define PGL_WIFI_PASS_1 "VOTRE_MDP_WIFI_1"
#define PGL_WIFI_SSID_2 "VOTRE_WIFI_2"
#define PGL_WIFI_PASS_2 "VOTRE_MDP_WIFI_2"

// Optionnel : 3e reseau (ex. partage telephone)
// #define PGL_WIFI_SSID_3 "VOTRE_WIFI_3"
// #define PGL_WIFI_PASS_3 "VOTRE_MDP_WIFI_3"

// Clé API partagée firmware <-> serveur (body api_key + header X-Api-Key)
// Doit être IDENTIQUE à PGL_API_KEY dans serveur/.env (pas API_KEY sauf fallback volontaire).
#define PGL_API_KEY "REMPLACER_PAR_CLE_FORTE"

// Optionnel — signature HMAC-SHA256 des requêtes /pgl/post-data et /pgl/heartbeat.
// Validé côté serveur : renseigner PGL_API_SIG_SECRET dans serveur/.env avec la
// MÊME valeur (repli sur le secret commun API_SIG_SECRET si PGL_API_SIG_SECRET est vide).
// Si défini ET NTP synchronisé, le firmware signe (timestamp+signature dans le body
// + en-têtes X-Sig-*) ; laisser commenté pour rester sur api_key (PGL_API_KEY).
// #define PGL_API_SIG_SECRET "REMPLACER_PAR_SECRET_HMAC"
