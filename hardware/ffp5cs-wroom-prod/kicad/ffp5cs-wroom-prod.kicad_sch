  (text "ALIMENTATION 5V (3A recommandé) — jack OU bornier.\nD5 protège le rail si l'USB du DevKit est branché en même temps." (exclude_from_sim no) (at 45.72 30.48 0)
    (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "0a7249cc-5415-59fc-8430-14cd60794a91"))
  (text "ESP32 DevKit V1 (30 broches, socketé).\nFlash/monitor via l'USB du module (pio run -e wroom-prod -t upload)." (exclude_from_sim no) (at 132.08 60.96 0)
    (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "43734e79-969f-5270-b79e-e46fed73c85e"))
  (text "SERVOS NOURRISSEURS 5V\nGPIO12 (strapping MTDI) : pull-down R22, signal série R20." (exclude_from_sim no) (at 111.76 127.00 0)
    (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "1815b54f-f011-5017-9dd4-3563850c5f8b"))
  (text "3x HC-SR04 (5V), mode mono-broche TRIG=ECHO (sensor_ultrasonic.cpp).\nEcho 5V ramené à 3V3 par pont 1k/2k sur chaque canal." (exclude_from_sim no) (at 218.44 25.40 0)
    (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "197ca988-1f48-5fbc-ac07-cc3410411686"))
  (text "AIR : DHT11 (option DHT22, -DUSE_DHT22) — pull-up 10k." (exclude_from_sim no) (at 218.44 121.92 0)
    (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "f7fc2bf7-c519-52d1-8a0a-b1e13ef78d94"))
  (text "EAU : DS18B20 (1-Wire, pull-up 4.7k)." (exclude_from_sim no) (at 218.44 154.94 0)
    (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "d4f91bc1-c575-5a75-94aa-9b79a6118f01"))
  (text "LUMIERE : LDR déportée + 10k (GPIO34 = entrée seule)." (exclude_from_sim no) (at 218.44 180.34 0)
    (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "1b6e31eb-661d-53f3-b9aa-34d5ec4995ce"))
  (text "I2C : OLED SSD1306 0x3C + header extension (DS3231 si besoin)." (exclude_from_sim no) (at 218.44 205.74 0)
    (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "bdf55c84-065d-5210-92ef-64ad0409346f"))
  (text "4 RELAIS 5V — commande ACTIVE HAUT (actuators.h : on() = digitalWrite HIGH).\nREL1=Pompe aquarium GPIO16, REL2=Pompe réservoir GPIO18,\nREL3=Chauffage GPIO2, REL4=Lumière GPIO15.\nGPIO2/GPIO15 = broches de strapping : pull-down base 10k = état sûr au boot." (exclude_from_sim no) (at 271.78 2.54 0)
    (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "acb6027d-10c1-5b85-9437-5aa2a4d8b862"))
  (text "GPIO libres pour évolutions." (exclude_from_sim no) (at 45.72 157.48 0)
    (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "638ed9b1-ab01-5de7-9181-150e5d404ba1"))
  (text "SITE A2 (option) : ESP32-S3-DevKitC-1, cartographie PINMAP_S3_CARRIER\n(pins.h). UN SEUL module peuplé : A1 (WROOM) OU A2 (S3).\nMêmes nets fonctionnels que A1 ; J20 = breakout GPIO S3 (AUX1=IO47, AUX2=IO42)." (exclude_from_sim no) (at 35.56 198.12 0)
    (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "5812f363-2667-5f5e-87c9-25d7823ff16c"))
