  (text "ESP32 DevKit V1 (30 broches, socketé).\nFlash/monitor via l'USB du module (pio run -e wroom-prod -t upload)." (exclude_from_sim no) (at 132.08 60.96 0)
    (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "a93d1173-a021-5fcd-99a9-8955dc4fc3d4"))
  (text "SERVOS NOURRISSEURS 5V\nGPIO12 (strapping MTDI) : pull-down R22, signal série R20." (exclude_from_sim no) (at 111.76 127.00 0)
    (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "75aa6f72-ba4e-54c6-8e66-1a59714ccfab"))
  (text "3x HC-SR04 (5V), mode mono-broche TRIG=ECHO (sensor_ultrasonic.cpp).\nEcho 5V ramené à 3V3 par pont 1k/2k sur chaque canal." (exclude_from_sim no) (at 218.44 25.40 0)
    (effects (font (size 1.7 1.7)) (justify left bottom)) (uuid "ed53dc9c-4c26-5d94-a608-7f4dbd8cd169"))
