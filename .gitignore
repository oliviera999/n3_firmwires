# Cles privees OTA (publiques OK dans n3_ota_pubkey.h, privees jamais)
*.key
*.pem
scripts/ota_keys/

# Backups / temporaire
ffp5cs_backup/

# Rapports locaux d'audit PlatformIO (scripts/Invoke-PioBuildAudit.ps1)
build-audit-*.txt
build_out.txt

# Sauvegardes d'edition (*.orig)
*.orig

# Logs de monitoring (generees par scripts PS1)
*.log
*.log.err
monitor_*.log
monitor_*.log.err

# IDE / OS
.vscode/
desktop.ini
.DS_Store
