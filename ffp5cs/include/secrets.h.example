#pragma once

// IMPORTANT: Ce fichier contient des informations sensibles
// Ne jamais commiter ce fichier dans le dépôt git !

// Clé API et email par défaut (inclus aussi par config.h via secrets_config.h)
#include "secrets_config.h"

// Inclure explicitement WifiManager pour le type Credential, sans contrainte d'ordre externe
#include "wifi_manager.h"

namespace Secrets {
// Email pour les notifications SMTP
constexpr const char* AUTHOR_EMAIL = "votre.email@example.com";
constexpr const char* AUTHOR_PASSWORD = "votre_mot_de_passe_app";

// Liste des réseaux WiFi connus
// Réseaux « dev / secours » (ex. box 4G) : ne pas embarquer dans le firmware **wroom-prod**
// (ESP32-WROOM + PROFILE_PROD). Le mot de passe n’alors même pas présent dans le .bin.
// wroom-test / wroom-beta : pas de PROFILE_PROD → ces entrées restent compilées.
inline constexpr WifiManager::Credential WIFI_LIST[] = {
  { "VOTRE_SSID_1", "VOTRE_MOT_DE_PASSE_1" },
#if !(defined(PROFILE_PROD) && defined(BOARD_WROOM))
  { "VOTRE_SSID_DEV_4G", "VOTRE_MOT_DE_PASSE_DEV" },
#endif
  { "VOTRE_SSID_2", "VOTRE_MOT_DE_PASSE_2" },
  { "VOTRE_SSID_3", "VOTRE_MOT_DE_PASSE_3" },
};

inline constexpr size_t WIFI_COUNT = sizeof(WIFI_LIST) / sizeof(WIFI_LIST[0]);
}
