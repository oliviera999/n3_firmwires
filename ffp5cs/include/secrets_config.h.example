#pragma once

// Secrets légers (clé API, email, auth web) — pas de dépendance externe.
// Copier ce fichier en `secrets_config.h` et remplir les valeurs réelles.
// Ne JAMAIS commiter `secrets_config.h` dans le dépôt git (cf. .gitignore).
//
// Ce header est inclus en premier par include/config.h (priorité sur credentials.h).
// Il doit définir au minimum :
//   - Secrets::API_KEY        : clé HMAC partagée avec serveur (.env API_KEY)
//   - Secrets::DEFAULT_RECIPIENT : destinataire des notifications mail au boot
//
// Sections optionnelles (recommandées en production) :
//   - SECRETS_INCLUDE_WEB_AUTH : activer pour personnaliser user/pass admin web
//
// v13.52 (2026-05) : ajout WEB_AUTH_USER/PASS et SECRETS_INCLUDE_WEB_AUTH ; rappel static_assert
// PROFILE_PROD refuse "CHANGEZ_MOI" comme valeur d'API_KEY ou WEB_AUTH_PASS.

namespace Secrets {
// Clé API serveur IoT (même valeur que API_KEY dans le .env du serveur)
// IMPORTANT : doit différer de "CHANGEZ_MOI" en PROFILE_PROD (static_assert).
constexpr const char* API_KEY = "votre_cle_api";

// Destinataire par défaut des notifications email
constexpr const char* DEFAULT_RECIPIENT = "destinataire@example.com";

// -----------------------------------------------------------------------------
// Authentification interface web locale (onglets protégés / routes admin)
// -----------------------------------------------------------------------------
// Décommenter le bloc suivant ET la ligne `#define SECRETS_INCLUDE_WEB_AUTH 1`
// ci-dessous pour utiliser ces identifiants. Sinon, le firmware retombe sur
// "admin" / "CHANGEZ_MOI" (refusé en PROFILE_PROD).
//
// constexpr const char* WEB_AUTH_USER = "admin";
// constexpr const char* WEB_AUTH_PASS = "votre_mot_de_passe_web_long_et_unique";
}
// #define SECRETS_INCLUDE_WEB_AUTH 1
